# DNR Customs — environment configuration
#
# Every value here is optional. With none of them set, the storefront runs on a
# built-in demo catalog and the manual payment provider, so `npm run dev` works
# on a fresh clone. Copy this file to `.env.local` and fill in what you need.

# ---------------------------------------------------------------------------
# Printful — product catalog and fulfilment
# ---------------------------------------------------------------------------

# Printful API token. Create one at:
#   Printful dashboard → Settings → Developers → Add token
# Give it Read access to "Products" and Read/Write to "Orders".
# Leave unset to run on the demo catalog.
PRINTFUL_API_KEY=

# Only required if the token is account-level rather than store-level.
# Store-level tokens already know their store and can ignore this.
PRINTFUL_STORE_ID=

# Orders are created as *unconfirmed drafts* by default. A draft is never
# printed and never charged, which is the safe setting while payments are
# still being wired up.
#
# Ignored while Stripe is enabled — the webhook confirms orders once payment
# clears, and auto-confirming as well would send unpaid orders to production.
# Only meaningful with the manual/invoice provider, where you have already
# arranged payment yourself.
PRINTFUL_AUTO_CONFIRM=false

# ---------------------------------------------------------------------------
# Stripe — optional; the storefront uses the manual provider until this is set
# ---------------------------------------------------------------------------

# Setting a secret key switches checkout over to Stripe Checkout automatically.
# Use a test key (sk_test_...) until you've run a full order through.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Signing secret for /api/webhooks/stripe, which confirms the Printful order
# once payment clears. Get it from the Stripe dashboard when you add the
# endpoint (subscribe it to checkout.session.completed), or from
# `stripe listen` when testing locally.
#
# Required for Stripe orders to reach production: without it the webhook
# refuses every request rather than confirming payments it cannot verify.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Absolute origin, used for metadata and payment redirect URLs.
# Must be the real public URL in production or Stripe redirects will 404.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown in the footer and on order confirmations.
CONTACT_EMAIL=hello@dnrcustoms.com
